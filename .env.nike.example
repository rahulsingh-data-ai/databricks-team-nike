# Nike workspace credentials + Lakebase setup
# Copy to .env and fill in the secret values.

# --- Databricks workspace ---
DATABRICKS_HOST=https://nike-sole-react.cloud.databricks.com
DATABRICKS_TOKEN=REPLACE_ME           # personal access token (dapi...)

# --- SQL Warehouse used for Delta queries ---
DATABRICKS_WAREHOUSE_ID=046329acb5dabe1f
# Maps to AppConfig.delta_warehouse_id; agents will fall back to Lakebase only
# if this is empty.
TEAM_NIKE_HACKATHON_DELTA_WAREHOUSE_ID=046329acb5dabe1f

# Catalog + schema where our medallion tables live on the Nike workspace.
TEAM_NIKE_HACKATHON_DELTA_FACILITIES_TABLE=development.dev_gps_research_insights.facilities_gold
CATALOG=development
SCHEMA=dev_gps_research_insights

# --- Lakebase ---
# Nike's existing Lakebase instance. Confirmed available via /api/2.0/database/instances.
LAKEBASE_INSTANCE_NAME=GPSI-Lakebase
LAKEBASE_DB=databricks_postgres
LAKEBASE_SCHEMA=referral_copilot

# --- LLM serving endpoint ---
# Nike workspace has ~69 ready endpoints. Default Claude Sonnet 4-6 for speed/quality.
TEAM_NIKE_HACKATHON_LLM_ENDPOINT=databricks-claude-sonnet-4-6

# --- Twilio (SMS path) ---
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_SMS_FROM=+15005550006

# --- MLflow tracing (opt-in) ---
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/your.email@nike.com/referral_copilot
